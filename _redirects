
# ==================================================
# MAQBALI.COM - REDIRECT MANAGEMENT
# إدارة روابط إعادة التوجيه
# ==================================================
#
# الصيغة:
# OLD_URL NEW_URL STATUS
#
# 301 = تحويل دائم
# 302 = تحويل مؤقت
#
# الأسطر التي تبدأ بعلامة # هي تعليقات فقط
# ==================================================


# [01] TOOLS - الأدوات
# توحيد رابط صفحة الأدوات
/tools /tools/ 301


# [02] QURAN - أداة القرآن
# توحيد الرابط الأساسي
/tools/quran /tools/quran/ 301

# الروابط القديمة لأداة القرآن
/quran /tools/quran/ 301
/quran/ /tools/quran/ 301
/quran/index.html /tools/quran/ 301

# CUSTOM REDIRECTS
/nfc-tools / 302
/flaticon-icons-preview / 302
/sahban / 302
/videos / 302


# [04] DYNAMIC REDIRECTS - تحويلات شاملة
# يفضل إبقاء التحويلات الشاملة في النهاية
/quran/* /tools/quran/:splat 301

# [05] 404 Page

/404 / 302
/404.html / 302


# ==================================================
# END OF REDIRECTS
# ==================================================
